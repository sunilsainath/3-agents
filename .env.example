# --- MyTrakin backend (placeholders only; never commit real secrets) ---
# Copy to backend/.env for local dev. Production uses managed secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Backend-only. HS256 dev secret OR leave empty to run guard in stub mode (tests).
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
API_CORS_ORIGINS=http://localhost:3000
